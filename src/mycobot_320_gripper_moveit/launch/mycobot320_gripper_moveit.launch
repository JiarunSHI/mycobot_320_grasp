<launch>

  <!-- specify the planning pipeline -->
  <arg name="pipeline" default="ompl" />

  <!-- By default, we do not start a database (it can be large) -->
  <arg name="db" default="false" />
  <!-- Allow user to specify database location -->
  <arg name="db_path" default="$(find mycobot_320_gripper_moveit)/default_warehouse_mongo_db" />

  <!-- By default, we are not in debug mode -->
  <arg name="debug" default="false" />

  <!-- By default, we will load or override the robot_description -->
  <arg name="load_robot_description" default="true"/>
  <arg name="model" default="$(find mycobot_description)/urdf/mycobot_320_m5_2020/mycobot_pro_320_m5_2020_gripper.urdf"/>

  <!-- Optional real-robot synchronization via serial port -->
  <arg name="sync_plan" default="false" />
  <arg name="port" default="/dev/ttyACM0" />
  <arg name="baud" default="115200" />
  <arg name="speed" default="80" />
  <arg name="gripper_speed" default="100" />
  <arg name="feedback_joint_state_topic" default="/joint_states" />
  <arg name="joint_state_rate" default="5.0" />
  <arg name="gripper_state_rate" default="2.0" />
  <arg name="gripper_control_enabled" default="false" />
  <arg name="gripper_feedback_enabled" default="false" />
  <arg name="initial_gripper_value" default="100" />
  <arg name="serial_command_queue_size" default="100" />
  <!-- Follow MoveIt's fake execution output when driving the real robot from RViz Execute. -->
  <arg name="sync_joint_state_topic" default="move_group/fake_controller_joint_states" />

  <!-- Choose controller manager: fake, simple, or ros_control -->
  <arg name="moveit_controller_manager" default="fake" />
  <!-- Set execution mode for fake execution controllers -->
  <arg name="fake_execution_type" default="interpolate" />

  <!-- Retained for launch compatibility. Real /joint_states come only from sync_plan. -->
  <arg name="use_gui" default="false" />
  <arg name="use_rviz" default="true" />

  <!-- SRDF and URDF expect world -> base_footprint -> base. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="virtual_joint_broadcaster_0" args="0 0 0 0 0 0 world base_footprint" />

  <!-- Build arm and gripper TF from the real joint feedback published by sync_plan. -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="true" output="screen">
    <remap from="joint_states" to="$(arg feedback_joint_state_topic)" />
  </node>

  <!-- Run the main MoveIt executable without trajectory execution (we do not have controllers configured by default) -->
  <include file="$(dirname)/move_group.launch">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="moveit_controller_manager" value="$(arg moveit_controller_manager)" />
    <arg name="fake_execution_type" value="$(arg fake_execution_type)"/>
    <arg name="info" value="true"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="pipeline" value="$(arg pipeline)"/>
    <arg name="load_robot_description" value="$(arg load_robot_description)"/>
    <arg name="model" value="$(arg model)"/>
  </include>

  <node if="$(arg sync_plan)" name="sync_plan" pkg="mycobot_320_gripper_moveit" type="sync_plan.py" output="screen">
    <param name="port" type="string" value="$(arg port)" />
    <param name="baud" type="int" value="$(arg baud)" />
    <param name="speed" type="int" value="$(arg speed)" />
    <param name="gripper_speed" type="int" value="$(arg gripper_speed)" />
    <param name="joint_state_topic" type="string" value="$(arg sync_joint_state_topic)" />
    <param name="feedback_joint_state_topic" type="string" value="$(arg feedback_joint_state_topic)" />
    <param name="joint_state_rate" type="double" value="$(arg joint_state_rate)" />
    <param name="gripper_state_rate" type="double" value="$(arg gripper_state_rate)" />
    <param name="gripper_control_enabled" type="bool" value="$(arg gripper_control_enabled)" />
    <param name="gripper_feedback_enabled" type="bool" value="$(arg gripper_feedback_enabled)" />
    <param name="initial_gripper_value" type="double" value="$(arg initial_gripper_value)" />
    <param name="command_queue_size" type="int" value="$(arg serial_command_queue_size)" />
  </node>

  <!-- Run Rviz and load the default config to see the state of the move_group node -->
  <include file="$(dirname)/moveit_rviz.launch" if="$(arg use_rviz)">
    <arg name="rviz_config" value="$(dirname)/moveit.rviz"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <!-- If database loading was enabled, start mongodb as well -->
  <include file="$(dirname)/default_warehouse_db.launch" if="$(arg db)">
    <arg name="moveit_warehouse_database_path" value="$(arg db_path)"/>
  </include>

</launch>
